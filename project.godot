; Engine configuration file.
; Godot Game UI Library — UI Blocks（积木库）: Godot Native Node + minimal script + Theme.

config_version=5

[application]

config/name="Godot Game UI Library"
config/description="Game UI blocks for Godot 4.x — use native nodes + Theme first, add minimal script only for behavior."
run/main_scene="res://demos/UIShowcase.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
