[gd_scene format=4]

[ext_resource type="Script" path="res://demos/button/button_demo.gd" id="1"]
[ext_resource type="PackedScene" path="res://blocks/button/Button.tscn" id="2"]
[ext_resource type="PackedScene" path="res://blocks/button/ScaleButton.tscn" id="3"]
[ext_resource type="PackedScene" path="res://blocks/button/ToggleButton.tscn" id="4"]

[node name="ButtonDemo" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
